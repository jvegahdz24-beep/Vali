# ═══════════════════════════════════════════════════════════════
# ValiAutoFlow — Environment Configuration Template
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# Database (SQLite — absolute path to your database file)
DATABASE_URL=file:/path/to/your/project/db/custom.db

# Authentication (NextAuth.js)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-random-32-char-string-here

# Application
NEXT_PUBLIC_APP_NAME=ValiAutoFlow
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp session storage directory
WHATSAPP_AUTH_DIR=.whatsapp-auth

# Seed endpoint protection PIN (required to seed/reset database)
SEED_PIN=change-me-to-a-secure-pin

# AI (z-ai-web-dev-sdk manages credentials internally)
# No external API keys needed
