# ═══════════════════════════════════════════
# ValiAutoFlow CRM v5.2.0 — Environment Variables
# ═══════════════════════════════════════════

# ── DATABASE (PostgreSQL) ──────────────────
# Pooled connection for app (via connection pooler in production)
DATABASE_URL=postgresql://valiflow:valiflow_prod_2026@localhost:5432/valiautoflow?connection_limit=10&pool_timeout=30
# Direct connection for migrations
DIRECT_URL=postgresql://valiflow:valiflow_prod_2026@localhost:5432/valiautoflow

# ── REDIS ──────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=valiflow:
REDIS_TTL_DEFAULT=3600
REDIS_TTL_SESSION=86400
REDIS_TTL_RATE_LIMIT=60

# ── APPLICATION ────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
DEBUG=false

# ── AUTH & SECURITY ────────────────────────
# MUST be at least 32 characters in production
NEXTAUTH_SECRET=nf8kL2mP9xR4wQ7sY3vB6jT0hN5cA1dE8fG4iK9zM2pX7
JWT_ACCESS_EXPIRY_SECONDS=900
JWT_REFRESH_EXPIRY_SECONDS=604800
SEED_PIN=
WORKER_KEY=
CRON_SECRET=

# ── AI Providers (Zhipu / Groq / DeepSeek / Gemini / OpenAI) ──
ZAI_API_KEY=
AI_DEFAULT_PROVIDER=glm
AI_DEFAULT_MODEL=glm-4.5-flash
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.7
AI_TIMEOUT_MS=30000

# ── Google OAuth ───────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/nexus/calendar/callback

# ── Email (Resend) ────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@valiautoflow.com

# ── WhatsApp (Baileys / Evolution API) ──
WHATSAPP_WEBHOOK_SECRET=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=
EVOLUTION_WEBHOOK_SECRET=

# ── Stripe Billing ────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=

# ── Demo Access (DISABLE in production) ────
DEMO_EMAIL=jvegahdz24@gmail.com
DEMO_PASSWORD=valiflow2026
DEMO_MODE=false

# ── Observability ──────────────────────────
LOG_LEVEL=info
LOG_FORMAT=pretty
PRISMA_LOG=false
