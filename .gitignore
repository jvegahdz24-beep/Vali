# ============================================
# ValiAutoFlow v2.0 — .gitignore
# ============================================

# --- Dependencies ---
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Next.js ---
/.next/
/out/
next-env.d.ts
next-service-dist

# --- Build / Production ---
/build
/dist

# --- Testing ---
/coverage

# --- Database ---
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3
prisma/migrations/

# --- Environment & Secrets ---
.env
.env.local
.env.production
.env.staging
!.env.example
.whatsapp-auth/

# --- Uploads & Media (user content) ---
/upload/
/media/
/db/

# --- Download & Generated Artifacts ---
/download/
*.tar
*.tar.gz
*.zip
*.7z

# --- Logs & Debug ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log
dev.out.log
server.log

# --- OS ---
.DS_Store
Thumbs.db
*.pem
*.swp
*.swo
*~

# --- TypeScript ---
*.tsbuildinfo

# --- Vercel ---
.vercel

# --- Skills (internal) ---
/skills/

# --- Workspace artifacts ---
.claude
.z-ai-config
.zscripts/
.accesslog
.stats
test
prompt
keepalive*.sh
analyze-frames.*

# --- Locked/internal files ---
_amad_ecosystem.config.js
/let
/production

# --- Misc ---
*.mp4
*.mp3
*.wav
*.avi
*.mov

# --- Mini services (build on deploy) ---
mini-services/

# --- IDE ---
.idea/
.vscode/
*.code-workspace
*.tmp

# AMAD backup: excluir dependencias/artefactos/medios regenerables
node_modules/
.next/
dist/
build/
out/
.cache/
.turbo/
.vercel/
coverage/
*.mkv
*.webm

# Local secrets and customer exports — never commit
.env
.env.*
!.env.example
public/exports/
scripts/persona-backup-*
