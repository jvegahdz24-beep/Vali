model BehavioralPattern {
  id            String   @id @default(cuid())
  workspaceId   String
  contactId     String?
  patternType   String // response_time, communication_frequency, topic_preference, buying_behavior, engagement_level
  patternValue  String   @db.Text // The detected pattern value (JSON for complex patterns)
  confidence    Float    @default(0.5) // 0.0 to 1.0
