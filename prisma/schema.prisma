// ─────────────────────────────────────────────────────────────
// MEDIA FILES (WhatsApp Business / Upload)
// ─────────────────────────────────────────────────────────────

model MediaFile {
  id              String   @id @default(cuid())
  workspaceId     String?
  messageId       String?
  conversationId  String?
  fileName        String
  mimeType        String
  fileSize        Int      @default(0) // bytes
  filePath        String   @db.Text // relative path on disk
  thumbnailPath   String?  @db.Text // optional thumbnail for images/videos
  width           Int?
  height          Int?
  durationSeconds Int?     // for audio/video
  caption         String?
  source          String   @default("whatsapp") // whatsapp, upload, webhook
  externalId      String?  // WhatsApp media ID
  metadata        String   @default("{}") @db.Text // JSON
