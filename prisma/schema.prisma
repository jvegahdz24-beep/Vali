model NexusProfile {
  userId                     String    @id // 1:1 with User, uses userId as PK
  workspaceId                String? // Optional: scope NEXUS data to a workspace
  age                        Int?
  gender                     String? // masculino, femenino, otro, no_especificar
  occupation                 String?
  company                    String?
  workSchedule               String    @default("{}") // JSON: {workStart:"09:00", workEnd:"18:00", days:["Mon-Fri"]}
  children                   Int       @default(0)
  relationshipStatus         String? // soltero, casado, divorciado, union_libre, viudo
  education                  String? // secundaria, preparatoria, licenciatura, maestria, doctorado, otro
  location                   String? // city, state, country
  whatsappPhone              String? // WhatsApp number for auto-summary (e.g. "+5215512345678")
  interests                  String    @default("[]") // JSON array of interests
  goals                      String    @default("[]") // JSON array of life goals
  bio                        String? // short bio about the user
  coachMode                  Boolean   @default(false) // life coach mode enabled
  summaryEnabled             Boolean   @default(false) // auto WhatsApp summary enabled
  summaryInterval            Int       @default(15) // minutes between WhatsApp summaries
  temperature                Float     @default(50.0) // current temperature 0-100
  tempUpdatedAt              DateTime?
  lastSummarySent            DateTime?
  vacationMode               Boolean   @default(false)
