// ═══════════════════════════════════════════════════════════════
// ValiFlow Pro — Fused Architecture Schema (v2.0)
// Next.js 16 + Prisma + SQLite (production-ready)
// PostgreSQL migration ready: see supabase/migration.sql
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// AUTH & MULTI-TENANCY
// ─────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          String    @default("member") // owner, admin, member
  phone         String?
  timezone      String    @default("America/Mexico_City")
  locale        String    @default("es-MX")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  workspaces      WorkspaceMember[]
  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")

  // NEXUS AI — Autonomous Assistant
  nexusConversations NexusConversation[]
  nexusMemories      NexusMemory[]
  nexusAgents        NexusAgent[]
  nexusTasks         NexusTask[]
  nexusInsights      NexusInsight[]
  nexusProfile       NexusProfile?
  nexusTempLogs      NexusTemperatureLog[] @relation("TempLogUser")
  nexusWhatsAppLogs  NexusWhatsAppLog[]   @relation("WhatsAppLogUser")
  nexusContacts    NexusContact[]

  @@index([email])
}

model Workspace {
  id                    String   @id @default(cuid())
  name                  String
  slug                  String   @unique
  logo                  String?
  industry              String   @default("automotive") // automotive, freelance, real-estate, etc
  plan                  String   @default("free") // free, starter, pro, enterprise
  whatsappPhoneId       String?
  whatsappToken         String?
  telegramBotToken      String?
  instagramToken        String?
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  mercadoPagoCustomerId String?
  isActive              Boolean  @default(true)
  settings              String   @default("{}") // JSON settings
  maxContacts           Int      @default(100)
  maxAgents             Int      @default(2)
  maxConversations      Int      @default(50)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  owner           User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  ownerId         String
  members         WorkspaceMember[]
  contacts        Contact[]
  conversations   Conversation[]
  pipelines       Pipeline[]
  agents          Agent[]
  automations     Automation[]
  followUpRules   FollowUpRule[]
  agentPersonas   AgentPersona[]
  webhookConfigs  WebhookConfig[]
  analyticsEvents AnalyticsEvent[]
  subscription    Subscription?
  deals           Deal[]
  leadProfiles    LeadProfile[]
  appointments    Appointment[]

  @@index([ownerId])
  @@index([slug])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        String   @default("member") // owner, admin, member, viewer
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// ─────────────────────────────────────────────────────────────
// CRM: CONTACTS
// ─────────────────────────────────────────────────────────────

model Contact {
  id            String    @id @default(cuid())
  workspaceId   String
  firstName     String
  lastName      String?
  phone         String?
  email         String?
  avatar        String?
  source        String    @default("whatsapp") // whatsapp, telegram, instagram, manual, webform
  tags          String    @default("[]") // JSON array
  customFields  String    @default("{}") // JSON object
  status        String    @default("active") // active, inactive, archived, blocked
  leadScore     Int       @default(0)
  temperature   String    @default("cold")
  notes         String?
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  deals         Deal[]
  agentMemories AgentMemory[]
  leadProfile   LeadProfile?
  appointments  Appointment[]

  @@unique([workspaceId, phone], name: "contact_workspace_phone_key")
  @@index([workspaceId])
  @@index([phone])
  @@index([status])
  @@index([lastMessageAt])
}

// ─────────────────────────────────────────────────────────────
// CONVERSATIONS & MESSAGES (Multi-Channel)
// ─────────────────────────────────────────────────────────────

model Conversation {
  id                 String   @id @default(cuid())
  workspaceId        String
  contactId          String?
  channel            String   @default("whatsapp") // whatsapp, telegram, instagram, webchat
  externalId         String? // ID from external provider (e.g. WhatsApp Business API)
  status             String   @default("active") // active, closed, pending, bot
  assignedTo         String? // userId
  assignedAgentId    String? // agent id
  lastMessageAt      DateTime @default(now())
  lastMessagePreview String?
  unreadCount        Int      @default(0)
  metadata           String   @default("{}") // JSON
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact    Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages   Message[]
  agentLogs  AgentLog[]
  mediaFiles MediaFile[]

  @@index([workspaceId])
  @@index([contactId])
  @@index([channel])
  @@index([status])
  @@index([lastMessageAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  content        String
  type           String   @default("text") // text, image, audio, video, document, location, interactive
  direction      String   @default("inbound") // inbound, outbound
  senderType     String   @default("contact") // contact, agent, human, system
  senderId       String?
  externalId     String?
  status         String   @default("sent") // sent, delivered, read, failed
  metadata       String   @default("{}") // JSON (media URL, buttons, etc)
  isAiGenerated  Boolean  @default(false)
  agentId        String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  mediaFiles   MediaFile[]

  @@index([conversationId])
  @@index([createdAt])
  @@index([direction])
}

// ─────────────────────────────────────────────────────────────
// AI AGENT SYSTEM (PicoClaw-Style)
// ─────────────────────────────────────────────────────────────

model Agent {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  type         String   @default("qualifier") // qualifier, sales, followup, coach, custom
  description  String?
  isActive     Boolean  @default(true)
  model        String   @default("glm") // groq, glm, deepseek, gemini, openai
  modelName    String   @default("glm-4.5-flash")
  temperature  Float    @default(0.7)
  maxTokens    Int      @default(4096)
  systemPrompt String   @default("")
  personality  String   @default("JHON") // JHON, professional, friendly, aggressive
  priority     Int      @default(0)
  config       String   @default("{}") // JSON: hooks, steering, fallback behavior
  webhookUrl   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  logs          AgentLog[]
  memories      AgentMemory[]
  followUpRules FollowUpRule[]

  @@index([workspaceId])
  @@index([type])
  @@index([isActive])
}

model AgentPersona {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  slug         String
  description  String?
  systemPrompt String
  tone         String   @default("professional") // professional, casual, aggressive, empathetic
  language     String   @default("es")
  hooks        String   @default("[]") // JSON: pre-processing hooks
  steering     String   @default("{}") // JSON: conversation steering rules
  revenueRules String   @default("[]") // JSON: revenue engine rules
  closingRules String   @default("[]") // JSON: closing engine rules
  isActive     Boolean  @default(true)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model AgentLog {
  id             String   @id @default(cuid())
  agentId        String
  conversationId String
  inputMessage   String
  outputMessage  String?
  model          String?
  tokensUsed     Int      @default(0)
  latencyMs      Int      @default(0)
  confidence     Float    @default(0)
  intent         String? // detected intent
  action         String? // action taken
  error          String?
  metadata       String   @default("{}") // JSON
  createdAt      DateTime @default(now())

  agent        Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([conversationId])
  @@index([createdAt])
}

model AgentMemory {
  id         String    @id @default(cuid())
  agentId    String
  contactId  String
  key        String
  value      String
  source     String    @default("conversation") // conversation, manual, system
  confidence Float     @default(1.0)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  agent   Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([agentId, contactId, key])
  @@index([agentId])
  @@index([contactId])
}

// ─────────────────────────────────────────────────────────────
// CRM: PIPELINE & DEALS
// ─────────────────────────────────────────────────────────────

model Pipeline {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    PipelineStage[]
  deals     Deal[]

  @@index([workspaceId])
}

model PipelineStage {
  id          String   @id @default(cuid())
  pipelineId  String
  name        String
  color       String   @default("#6366f1")
  order       Int      @default(0)
  probability Int      @default(0) // 0-100 win probability
  isWon       Boolean  @default(false)
  isLost      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@unique([pipelineId, order])
  @@index([pipelineId])
}

model Deal {
  id                String    @id @default(cuid())
  workspaceId       String
  pipelineId        String
  stageId           String
  contactId         String?
  assignedTo        String? // userId
  title             String
  value             Float     @default(0)
  currency          String    @default("MXN")
  description       String?
  source            String    @default("whatsapp") // whatsapp, telegram, instagram, manual
  status            String    @default("active") // active, won, lost, paused
  wonAt             DateTime?
  lostAt            DateTime?
  lostReason        String?
  closedBy          String? // userId or agentId
  metadata          String    @default("{}") // JSON
  order             Int       @default(0)
  expectedCloseDate DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline  Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage     PipelineStage @relation(fields: [stageId], references: [id])
  contact   Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([pipelineId])
  @@index([stageId])
  @@index([contactId])
  @@index([status])
  @@index([expectedCloseDate])
}

// ─────────────────────────────────────────────────────────────
// FOLLOW-UP AUTOMATION
// ─────────────────────────────────────────────────────────────

model FollowUpRule {
  id              String   @id @default(cuid())
  workspaceId     String
  agentId         String?
  name            String
  description     String?
  triggerType     String   @default("inactivity") // inactivity, scheduled, event-based, deal-stage-change
  triggerConfig   String   @default("{}") // JSON
  channel         String   @default("whatsapp")
  messageTemplate String   @default("")
  isActive        Boolean  @default(true)
  maxRetries      Int      @default(3)
  cooldownHours   Int      @default(24)
  priority        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([isActive])
}

model FollowUpTask {
  id             String    @id @default(cuid())
  workspaceId    String
  ruleId         String
  contactId      String
  conversationId String
  status         String    @default("pending") // pending, sent, failed, cancelled
  scheduledAt    DateTime
  sentAt         DateTime?
  retryCount     Int       @default(0)
  error          String?
  createdAt      DateTime  @default(now())

  @@index([workspaceId])
  @@index([status])
  @@index([scheduledAt])
}

// ─────────────────────────────────────────────────────────────
// AUTOMATIONS
// ─────────────────────────────────────────────────────────────

model Automation {
  id            String    @id @default(cuid())
  workspaceId   String
  name          String
  description   String?
  triggerType   String // webhook, schedule, event, message_received, deal_stage_change
  triggerConfig String    @default("{}") // JSON
  actions       String    @default("[]") // JSON array of actions
  isActive      Boolean   @default(true)
  runCount      Int       @default(0)
  lastRunAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  logs      AutomationLog[]

  @@index([workspaceId])
  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────
// AUTOMATION LOGS
// ─────────────────────────────────────────────────────────────

model AutomationLog {
  id           String   @id @default(cuid())
  automationId String
  workspaceId  String
  status       String   @default("success") // success, failed, skipped
  action       String?
  message      String?
  contactId    String?
  contactName  String?
  metadata     String   @default("{}") // JSON
  createdAt    DateTime @default(now())

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@index([workspaceId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// BILLING & SUBSCRIPTIONS
// ─────────────────────────────────────────────────────────────

model Subscription {
  id                   String    @id @default(cuid())
  workspaceId          String    @unique
  plan                 String    @default("free") // free, starter, pro, enterprise
  status               String    @default("active") // active, past_due, cancelled, trialing
  provider             String    @default("stripe") // stripe, mercado_pago
  providerPlanId       String?
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  trialEnd             DateTime?
  cancelAt             DateTime?
  cancelledAt          DateTime?
  amount               Float     @default(0)
  currency             String    @default("MXN")
  interval             String    @default("monthly") // monthly, yearly
  metadata             String    @default("{}") // JSON
  stripeCustomerId     String? // Stripe customer ID
  stripeSubscriptionId String? // Stripe subscription ID

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// ANALYTICS & EVENTS
// ─────────────────────────────────────────────────────────────

model AnalyticsEvent {
  id          String   @id @default(cuid())
  workspaceId String
  eventType   String // conversation_created, message_sent, deal_won, agent_used, etc
  eventData   String   @default("{}") // JSON
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([eventType])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// WEBHOOK CONFIGS
// ─────────────────────────────────────────────────────────────

model WebhookConfig {
  id          String   @id @default(cuid())
  workspaceId String
  channel     String // whatsapp, telegram, instagram, stripe, mercado_pago
  webhookUrl  String?
  secret      String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([channel])
}

// ─────────────────────────────────────────────────────────────
// MEDIA FILES (WhatsApp Business / Upload)
// ─────────────────────────────────────────────────────────────

model MediaFile {
  id              String   @id @default(cuid())
  workspaceId     String?
  messageId       String?
  conversationId  String?
  fileName        String
  mimeType        String
  fileSize        Int      @default(0) // bytes
  filePath        String // relative path on disk
  thumbnailPath   String? // optional thumbnail for images/videos
  width           Int?
  height          Int?
  durationSeconds Int? // for audio/video
  caption         String?
  source          String   @default("whatsapp") // whatsapp, upload, webhook
  externalId      String? // WhatsApp media ID
  metadata        String   @default("{}") // JSON
  createdAt       DateTime @default(now())

  message      Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([messageId])
  @@index([conversationId])
  @@index([source])
}

// ─────────────────────────────────────────────────────────────
// DIB: LEAD PROFILE (Reactivation Intelligence Layer)
// ─────────────────────────────────────────────────────────────

model LeadProfile {
  id          String @id @default(cuid())
  contactId   String @unique
  workspaceId String

  // Archetype Detection
  archetype           String @default("desconocido") // practico, familiar, aspiracional, estrategico, consciente, desconocido
  archetypeConfidence Float  @default(0)

  // Temperature (real-time scoring)
  temperature String @default("cold") // cold, warm, hot
  score       Int    @default(0) // 0-100

  // Behavioral signals
  totalMessages     Int       @default(0)
  avgResponseTimeMs Int       @default(0)
  lastActiveAt      DateTime?
  firstSeenAt       DateTime  @default(now())

  // Reactivation tracking
  reactivateCount   Int       @default(0) // how many times DIB reactivated this lead
  lastReactivateAt  DateTime?
  lastAngleUsed     String? // which psychological angle was last used
  reactivationCycle Int       @default(0) // current cycle number (1-4)
  isReactivable     Boolean   @default(true)

  // Extracted data (from conversation parsing)
  budget             String? // detected budget range
  preferredProduct   String? // product/service of interest
  mainObjection      String? // primary objection
  decisionMaker      String? // who decides (self, partner, boss)
  timeline           String? // when they want to buy (now, soon, later, none)
  communicationStyle String  @default("neutral") // direct, cautious, emotional, analytical, neutral

  // Psychological profile (for reactivation engine)
  painPoints       String  @default("[]") // JSON array of detected pain points
  interests        String  @default("[]") // JSON array of detected interests
  buyingMotivation String? // status, comfort, security, savings, excitement
  priceSensitivity String  @default("medium") // low, medium, high
  urgencyLevel     String  @default("low") // low, medium, high

  // Metadata
  metadata  String   @default("{}") // JSON
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([workspaceId])
  @@index([temperature])
  @@index([isReactivable])
}

// ─────────────────────────────────────────────────────────────
// APPOINTMENTS / CALENDAR
// ─────────────────────────────────────────────────────────────

model Appointment {
  id          String   @id @default(cuid())
  workspaceId String
  contactId   String?
  title       String
  description String?
  date        DateTime
  duration    Int      @default(30) // minutes
  type        String   @default("call") // call, meeting, followup, task
  status      String   @default("pending") // pending, completed, cancelled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([contactId])
  @@index([date])
  @@index([status])
  @@index([type])
}

// ─────────────────────────────────────────────────────────────
// WHATSAPP AUTH PERSISTENCE (Cloud-safe)
// ─────────────────────────────────────────────────────────────

model WhatsAppAuth {
  id        String   @id @default(cuid())
  workspace String   @unique
  authData  String // JSON: { "creds.json": {...}, "app-state-sync-key-1.json": {...}, ... }
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// JHON ENGINE — Events, Memory & Autonomy
// ─────────────────────────────────────────────────────────────

model EngineEvent {
  id          String   @id @default(cuid())
  workspaceId String
  contactId   String
  type        String // INTENT_DETECTED, SCORE_UPDATED, TEMPERATURE_CHANGED, ACTION_RECOMMENDED, ACTION_EXECUTED, ACTION_OUTCOME, AUTO_ACTION_TRIGGERED, DECAY_APPLIED, PATTERN_IDENTIFIED
  subType     String? // For ACTION_OUTCOME: REPLIED, NO_RESPONSE_2H, NO_RESPONSE_24H, INTEREST_CONFIRMED, MEETING_BOOKED, GHOSTED, CLOSED_WON, CLOSED_LOST. For patterns: asked_price, requested_info, etc.
  metadata    String   @default("{}") // JSON: { action, expectedOutcome, deadline, ifNotMet, decisionTrace, patternEffectiveness, scoreDelta, ... }
  score       Int? // Score at time of event
  temperature String? // Temperature at time of event
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([contactId])
  @@index([type])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// NEXUS AI — Autonomous Assistant Models
// ─────────────────────────────────────────────────────────────

model NexusConversation {
  id          String   @id @default(cuid())
  userId      String
  title       String   @default("Nueva conversación")
  agentType   String   @default("nexus") // nexus, coder, analyst, writer, researcher
  status      String   @default("active") // active, archived, deleted
  context     String   @default("{}") // JSON: conversation context/metadata
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages NexusMessage[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model NexusMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // user, assistant, system
  content        String
  tokens         Int      @default(0)
  model          String?
  latencyMs      Int      @default(0)
  metadata       String   @default("{}") // JSON: tools used, citations, etc
  createdAt      DateTime @default(now())

  conversation NexusConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([role])
  @@index([createdAt])
}

model NexusMemory {
  id        String   @id @default(cuid())
  userId    String
  category  String   @default("general") // preference, fact, instruction, context, skill
  key       String
  value     String
  source    String   @default("conversation") // conversation, manual, system, inferred
  importance Int     @default(5) // 1-10
  accessCount Int    @default(0)
  lastAccessed DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
  @@index([category])
  @@index([importance])
}

model NexusAgent {
  id          String   @id @default(cuid())
  userId      String
  name        String
  type        String   @default("nexus") // nexus, coder, analyst, writer, researcher, custom
  description String?
  systemPrompt String  @default("")
  personality  String  @default("professional") // professional, creative, analytical, friendly
  capabilities String  @default("[]") // JSON array of capabilities
  isActive    Boolean  @default(true)
  config      String   @default("{}") // JSON config
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([isActive])
}

model NexusTask {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  status      String   @default("pending") // pending, in_progress, completed, failed, cancelled
  priority    String   @default("medium") // low, medium, high, critical
  source      String   @default("user") // user, autonomous, system
  dueDate     DateTime?
  completedAt DateTime?
  result      String?  // JSON: task result/output
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model NexusInsight {
  id        String   @id @default(cuid())
  userId    String
  type      String   // pattern, suggestion, anomaly, learning
  title     String
  content   String
  confidence Float   @default(0)
  isRead    Boolean  @default(false)
  metadata  String   @default("{}") // JSON
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// NEXUS AI — Life Coach Profile & Temperature
// ─────────────────────────────────────────────────────────────

model NexusProfile {
  userId            String   @id // 1:1 with User, uses userId as PK
  age               Int?
  gender            String?  // masculino, femenino, otro, no_especificar
  occupation        String?
  company           String?
  workSchedule      String   @default("{}") // JSON: {workStart:"09:00", workEnd:"18:00", days:["Mon-Fri"]}
  children          Int      @default(0)
  relationshipStatus String? // soltero, casado, divorciado, union_libre, viudo
  education         String?  // secundaria, preparatoria, licenciatura, maestria, doctorado, otro
  location          String?  // city, state, country
  whatsappPhone     String?  // WhatsApp number for auto-summary (e.g. "+5215512345678")
  interests         String   @default("[]") // JSON array of interests
  goals             String   @default("[]") // JSON array of life goals
  bio               String?  // short bio about the user
  coachMode         Boolean  @default(false) // life coach mode enabled
  summaryEnabled    Boolean  @default(false) // auto WhatsApp summary enabled
  summaryInterval   Int      @default(15) // minutes between WhatsApp summaries
  temperature       Float    @default(50.0) // current temperature 0-100
  tempUpdatedAt     DateTime?
  lastSummarySent   DateTime?
  vacationMode              Boolean  @default(false)
  googleCalendarConnected   Boolean  @default(false)
  googleCalendarToken       String?
  googleCalendarRefreshToken String?
  googleCalendarSyncEnabled Boolean  @default(false)
  vacationStartAt           DateTime?
  vacationEndAt             DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tempLogs      NexusTemperatureLog[] @relation("TempLogProfile")
  whatsappLogs  NexusWhatsAppLog[]   @relation("WhatsAppLogProfile")

  @@index([userId])
}

model NexusTemperatureLog {
  id        String   @id @default(cuid())
  userId    String
  value     Float    // 0-100
  label     String?  // optional label like "Después de conversación", "Checkpoint"
  source    String   @default("system") // system, conversation, manual, ai_analysis
  metadata  String   @default("{}") // JSON
  createdAt DateTime @default(now())

  profile NexusProfile @relation("TempLogProfile", fields: [userId], references: [userId], onDelete: Cascade)
  user    User          @relation("TempLogUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model NexusWhatsAppLog {
  id        String   @id @default(cuid())
  userId    String
  phone     String
  message   String
  type      String   @default("summary") // summary, checkin, alert, test
  status    String   @default("pending") // pending, sent, failed
  sentAt    DateTime?
  error     String?
  createdAt DateTime @default(now())

  profile NexusProfile @relation("WhatsAppLogProfile", fields: [userId], references: [userId], onDelete: Cascade)
  user    User          @relation("WhatsAppLogUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// NEXUS AI — Personal Contacts
// ─────────────────────────────────────────────────────────────

model NexusContact {
  id          String   @id @default(cuid())
  userId      String
  name        String
  phone       String?
  email       String?
  relation    String   @default("amigo") // familiar, amigo, companero, jefo, colega, otro
  company     String?
  role        String?
  birthday    String?  // "MM-DD" format
  notes       String?
  isFavorite  Boolean  @default(false)
  tags        String   @default("[]") // JSON array of tags
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([relation])
}
