  id          String   @id @default(cuid())
  workspaceId String
  kind        String   @default("fact") // preference | fact | lesson | shortcut
  content     String   @db.Text
  dedupeKey   String?  // contenido normalizado para evitar duplicados
  source      String   @default("auto") // auto (autodidacta) | user (se lo pediste)
  uses        Int      @default(0)
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model ScheduledPost {
  id          String   @id @default(cuid())
  workspaceId String
  carId       String
  networks    String   @default("[]") // JSON
  formats     String   @default("[]") // JSON
  templates   String   @default("{}") // JSON {feed,story}
  caption     String?  @db.Text
  withVideo   Boolean  @default(false)
  videoConfig String?  @db.Text // JSON config del reel (si withVideo)
  scheduledAt DateTime
  status      String   @default("pending") // pending | done | error | cancelled
  result      String?  @db.Text
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, scheduledAt])
  @@index([status, scheduledAt])
}

model CreativeTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  kind        String   @default("video") // video | image
  config      String   @db.Text          // JSON: escenas, color, transición, kenBurns, música, voz, marca de agua...
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model CreativeScript {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  content     String   @db.Text
  tone        String?
  durationSec Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ─────────────────────────────────────────────────────────────
// META CLOUD API (WhatsApp Business API Oficial)
// ─────────────────────────────────────────────────────────────

model MetaApiConfig {
  id               String   @id @default(cuid())
  workspaceId      String   @unique
  phoneNumberId    String               // Meta Phone Number ID (from Meta Developer Console)
  accessToken      String   @db.Text   // Permanent System User Access Token
  webhookSecret    String               // Secret for HMAC-SHA256 signature verification
  businessId       String?              // Meta Business Account ID (for template mgmt)
  displayPhone     String?              // Human-readable phone number e.g. +52 55 1234 5678
  qualityRating    String?              // GREEN | YELLOW | RED (from Meta API)
  isActive         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace  Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([phoneNumberId])
}

model MetaMessageTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  metaId      String?              // Meta's internal template ID
  name        String               // Template name (snake_case, as registered in Meta)
  category    String   @default("UTILITY") // MARKETING | UTILITY | AUTHENTICATION
  language    String   @default("es_MX")
  status      String   @default("PENDING") // APPROVED | REJECTED | PENDING | PAUSED
  components  String   @db.Text @default("[]") // JSON array of template components
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([status])
  @@index([name])
}

// ─────────────────────────────────────────────────────────────
// MÓDULOS DINÁMICOS DEL AGENTE IA
// ─────────────────────────────────────────────────────────────

model WorkspaceModule {
  id          String   @id @default(cuid())
  workspaceId String
  moduleType  String   // agent_profile | physical_location | appointments | catalog
  enabled     Boolean  @default(false)
  config      String   @default("{}") @db.Text // JSON config específico del módulo
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, moduleType])
  @@index([workspaceId])
  @@index([moduleType])
}

model CatalogItem {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?  @db.Text
  price       Float?
  currency    String   @default("MXN")
  category    String?
  stock       Int?     // null = stock ilimitado
  isActive    Boolean  @default(true)
  imageUrl    String?
  metadata    String   @default("{}") @db.Text // JSON: extras como talla, color, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([category])
  @@index([isActive])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// MÓDULO 1: CATÁLOGO MULTIMEDIA
// ─────────────────────────────────────────────────────────────

model MediaAsset {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  url         String
  type        String   // image | video | pdf | audio
  tags        String   @default("[]") @db.Text // JSON string array
  description String?  @db.Text
  fileSize    Int?     // bytes
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  triggers    MediaTrigger[]

  @@index([workspaceId])
  @@index([type])
  @@index([isActive])
}

model MediaTrigger {
  id          String   @id @default(cuid())
  workspaceId String
  assetId     String
  phrase      String   // keyword/phrase that triggers sending this asset
  intent      String?  // optional: only trigger on this detected intent
  stage       String?  // optional: only trigger at this pipeline stage
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  asset       MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([assetId])
}

// ─────────────────────────────────────────────────────────────
// MÓDULO 2: MOTOR DE SEGUIMIENTO EDUCATIVO
// ─────────────────────────────────────────────────────────────

model EducationCampaign {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?  @db.Text
  trigger     String   // new_lead | inactive_3d | inactive_7d | quoted | custom
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  steps       EducationStep[]
  executions  EducationExecution[]

  @@index([workspaceId])
  @@index([trigger])
  @@index([isActive])
}

model EducationStep {
  id           String   @id @default(cuid())
  campaignId   String
  stepNumber   Int
  delayMinutes Int      // delay from previous step (0 = send immediately)
  type         String   @default("text") // text | image | video | pdf
  content      String   @db.Text         // message text; supports {{name}}, {{firstName}}
  assetId      String?  // optional media asset to send with this step
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  campaign     EducationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, stepNumber])
  @@index([campaignId])
}

model EducationExecution {
  id             String    @id @default(cuid())
  campaignId     String
  workspaceId    String
  contactId      String
  conversationId String
  currentStep    Int       @default(0)
  status         String    @default("active") // active | completed | paused | cancelled
  nextStepAt     DateTime?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  campaign       EducationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([campaignId])
  @@index([contactId])
  @@index([status])
  @@index([nextStepAt])
}

// ─────────────────────────────────────────────────────────────
// MÓDULO 4: REPOSITORIO DE GANCHOS PSICOLÓGICOS
// ─────────────────────────────────────────────────────────────

model Hook {
  id          String   @id @default(cuid())
  workspaceId String
  text        String   @db.Text
  category    String   // scarcity | urgency | social_proof | reciprocity | microclose | objection
  usageCount  Int      @default(0)
  winCount    Int      @default(0) // times this hook was followed by a positive outcome
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false) // true = seeded by system, user can edit but not delete
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([category])
  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────
// MÓDULO 5: ACTIVIDAD DEL LEAD (mejor horario de contacto)
// ─────────────────────────────────────────────────────────────

model LeadActivity {
  id           String   @id @default(cuid())
  workspaceId  String
  contactId    String
  responseHour Int      // 0-23: hour of day the lead responded
  responseDow  Int      // 0=Sun 1=Mon ... 6=Sat
  count        Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, contactId, responseHour, responseDow])
  @@index([workspaceId])
  @@index([contactId])
}

// ─────────────────────────────────────────────────────────────
// SECTION 10: TEAM INVITATIONS
// ─────────────────────────────────────────────────────────────

model Invitation {
  id          String   @id @default(cuid())
  workspaceId String
  email       String
  role        String   @default("member") // owner, admin, member, viewer
  token       String   @unique
  sentById    String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sentBy    User?     @relation("InvitationSender", fields: [sentById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([email])
  @@index([token])
}

// ─────────────────────────────────────────────────────────────
// SECTION 13: VALIGUARD — CONSENT & AUDIT LOG
// ─────────────────────────────────────────────────────────────

model Consent {
  id          String   @id @default(cuid())
  workspaceId String
  contactId   String
  phone       String?
  ip          String?
  acceptedAt  DateTime @default(now())
  revokedAt   DateTime?
  isActive    Boolean  @default(true)
  source      String   @default("whatsapp") // whatsapp, webform, manual
  metadata    String   @default("{}") @db.Text

  @@unique([workspaceId, contactId])
  @@index([workspaceId])
  @@index([contactId])
}

model ConsentLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String?
  action      String   // view_contact, export_csv, view_conversation, assign_agent
  resourceId  String?
  resourceType String? // contact, conversation, message
  ip          String?
  metadata    String   @default("{}") @db.Text
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// ValiGuard — registro de sesiones/accesos (IP, dispositivo, ubicación reales)
model AccessSession {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  ip          String?
  userAgent   String?  @db.Text
  browser     String?
  os          String?
  device      String?  // Desktop | Móvil | Tablet
  city        String?
  region      String?
  country     String?  // código ISO (CF) o nombre
  isActive    Boolean  @default(true)
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  revokedAt   DateTime?

  @@index([workspaceId])
  @@index([userId])
  @@index([isActive])
  @@index([createdAt])
}


// ─────────────────────────────────────────────────────────────
// IMPORT JOBS
// ─────────────────────────────────────────────────────────────
// Historial durable de importaciones. Los campos JSON se almacenan como texto
// para mantener compatibilidad con el proveedor MySQL actual del schema.
model ImportJob {
  id            String    @id @default(cuid())
  workspaceId   String
  status        String    @default("pending") // pending, processing, completed, failed
  fileName      String
  fileSize      Int?
  fileType      String?
  rowsTotal     Int       @default(0)
  rowsProcessed Int       @default(0)
  rowsCreated   Int       @default(0)
  rowsUpdated   Int       @default(0)
  rowsSkipped   Int       @default(0)
  errors        String    @default("[]") @db.Text
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([status])
  @@index([createdAt])
}
