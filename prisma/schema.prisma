  redirectUri  String?  @db.Text
  accessToken  String?  @db.Text
  refreshToken String?  @db.Text
  expiresAt    DateTime?
  meliUserId   String?
  nickname     String?
  status       String   @default("disconnected") // disconnected | connected | error
  scope        String?  @db.Text
  lastError    String?  @db.Text
  codeVerifier String?  @db.Text // PKCE: code_verifier del flujo OAuth en curso
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model MeliListing {
  id                String   @id @default(cuid())
  workspaceId       String
  catalogItemId     String?
  meliItemId        String
  permalink         String?  @db.Text
  title             String?  @db.Text
  status            String   @default("active") // active | paused | closed | under_review
  price             Float?
  availableQuantity Int?
  soldQuantity      Int      @default(0)
  thumbnail         String?  @db.Text
