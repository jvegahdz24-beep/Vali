  createdAt DateTime @default(now())

  profile NexusProfile @relation("TempLogProfile", fields: [userId], references: [userId], onDelete: Cascade, map: "NexusTemperatureLog_profile_fkey")
  user    User         @relation("TempLogUser", fields: [userId], references: [id], onDelete: Cascade, map: "NexusTemperatureLog_user_fkey")

  @@index([userId])
  @@index([createdAt])
