// ═══════════════════════════════════════════════════════════════
// ValiFlow Pro — Fused Architecture Schema (v2.0)
// Next.js 16 + Prisma + MySQL (XAMPP)
// Migrated from SQLite to MySQL
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// AUTH & MULTI-TENANCY
// ─────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Pending registrations awaiting email code verification
// Replaces in-memory store for persistence across restarts (VULN-016)
model EmailVerification {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  hashedPassword String
  code           String
  expiresAt      DateTime
  attempts       Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([email])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          String    @default("member") // owner, admin, member, superadmin
  phone         String?
  timezone      String    @default("America/Mexico_City")
  locale        String    @default("es-MX")
  // SEC-007: Account lockout fields
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  telegramChatId      String?   // Section 15: Telegram notification center
  // One-time deep-link token used by /api/telegram/link → /start <token>
  telegramLinkToken        String?   @unique
  telegramLinkTokenExpires DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  workspaces    WorkspaceMember[]
  ownedWorkspaces Workspace[] @relation("WorkspaceOwner")
  invitationsSent Invitation[] @relation("InvitationSender")
  couponsCreated Coupon[] @relation("CouponCreator")

  @@index([email])
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  industry    String   @default("automotive") // automotive, freelance, real-estate, etc
  plan        String   @default("free")       // free, starter, pro, enterprise
  whatsappPhoneId  String?
  whatsappToken    String?
  waChannel        String   @default("baileys") // baileys | meta
  telegramBotToken String?
  instagramToken   String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  mercadoPagoCustomerId String?
  isActive    Boolean  @default(true)
  settings    String   @default("{}") @db.Text // JSON settings
  maxContacts     Int @default(100)
  maxAgents       Int @default(2)
  maxConversations Int @default(50)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User             @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  ownerId String
  members WorkspaceMember[]
  contacts    Contact[]
  conversations Conversation[]
  pipelines   Pipeline[]
  agents      Agent[]
  automations Automation[]
  followUpRules FollowUpRule[]
  agentPersonas AgentPersona[]
  webhookConfigs WebhookConfig[]
  analyticsEvents AnalyticsEvent[]
  subscription Subscription?
  deals Deal[]
  leadProfiles LeadProfile[]
  appointments Appointment[]
  marketingCampaigns MarketingCampaign[]
  marketingContents  MarketingContent[]
  contentCalendar    ContentCalendarEntry[]
  marketingAutomations MarketingAutomation[]
  metaApiConfig      MetaApiConfig?
  metaTemplates      MetaMessageTemplate[]
  modules            WorkspaceModule[]
  catalogItems       CatalogItem[]
  mediaAssets        MediaAsset[]
  mediaTriggers      MediaTrigger[]
  educationCampaigns EducationCampaign[]
  educationExecutions EducationExecution[]
  hooks              Hook[]
  leadActivities     LeadActivity[]
  expedienteFiles    ExpedienteFile[]
  timelineEvents     ContactTimelineEvent[]
  aiTrainingExamples AiTrainingExample[]
  meliConnection     MeliConnection?
  meliListings       MeliListing[]
  meliLogs           MeliLog[]
  marketingPosts     MarketingPost[]
  marketingBotConfig MarketingBotConfig?
  creativeTemplates  CreativeTemplate[]
  creativeScripts    CreativeScript[]
  scheduledPosts     ScheduledPost[]
  copilotMemories    CopilotMemory[]
  dailyAnalytics     DailyAnalytics[]
  invitations        Invitation[]
  agentTemplates     AgentTemplate[]
  agentInstances     AgentInstance[]
  knowledgeDocs      KnowledgeDoc[]
  pendingApprovals   PendingApproval[]
  metaChannels       MetaChannel[]
  importJobs         ImportJob[]

  @@index([ownerId])
  @@index([slug])
}

// ─────────────────────────────────────────────────────────────
// Canales Meta (Instagram DM + Facebook Messenger)
// Un row por página conectada. El webhook busca por pageId (Messenger) o
// igAccountId (Instagram) para resolver el workspace (multi-tenant seguro).
// ─────────────────────────────────────────────────────────────
model MetaChannel {
  id              String   @id @default(cuid())
  workspaceId     String
  pageId          String   @unique
  pageName        String?
  igAccountId     String?  @unique
  pageAccessToken String   @db.Text
  verifyToken     String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ─────────────────────────────────────────────────────────────
// Aprobación humana de acciones críticas (Verificación/Control)
// Antes de ejecutar un pago o factura, la IA crea una aprobación
// pendiente; el operador la aprueba/rechaza y solo entonces se ejecuta.
// ─────────────────────────────────────────────────────────────
model PendingApproval {
  id             String    @id @default(cuid())
  workspaceId    String
  contactId      String?
  conversationId String?
  type           String    // payment, invoice
  summary        String    // texto legible para el operador
  payload        String    @db.Text // JSON con los datos para ejecutar la acción
  status         String    @default("pending") // pending, approved, rejected, executed, failed
  resultNote     String?
  resolvedBy     String?   // userId
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// gBrain — BASE DE CONOCIMIENTO (RAG-lite)
// Documentos/manuales/FAQs de la empresa que el agente consulta ANTES de
// responder (recuperación por relevancia de palabras clave sobre el texto
// extraído). Que el bot responda con datos REALES, no invente.
// ─────────────────────────────────────────────────────────────
model KnowledgeDoc {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  sourceType  String   @default("text") // text, pdf, xlsx, csv, faq
  content     String   @db.Text
  chars       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ─── gBrain Agent Factory ──────────────────────────────────────
// AgentTemplate: plantilla vertical reutilizable (75% común). Puede ser
// global (workspaceId null, sembrada desde el registry de código) o propia
// de un workspace. AgentInstance: agente instanciado y vinculado a un
// workspace (= ClientPod en la nomenclatura v3.5), con su prompt ya resuelto.
model AgentTemplate {
  id                 String   @id @default(cuid())
  name               String
  vertical           String   // email-marketing, seguros, financiamiento, ventas, custom, ...
  description        String   @db.Text
  systemPrompt       String   @db.Text // con placeholders {{cliente}}, {{voz}}, etc.
  tools              String   @default("[]") @db.Text // JSON array of tool names
  exampleDialogues   String   @default("[]") @db.Text // JSON array of {user, assistant}
  qualityChecklist   String   @default("[]") @db.Text // JSON array of strings
  humanApprovalGates String   @default("[]") @db.Text // JSON array of gate names
  forbiddenActions   String   @default("[]") @db.Text // JSON array
  keywords           String   @default("[]") @db.Text // JSON array — routing por palabra clave
  customizationPct   Int      @default(25)
  version            String   @default("1.0.0")
  isGlobal           Boolean  @default(false)
  workspaceId        String?
  workspace          Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  instances          AgentInstance[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([vertical])
  @@index([workspaceId])
}

model AgentInstance {
  id                 String   @id @default(cuid())
  name               String
  role               String   // QUALIFIER, CLOSER, SEGURO, FINAN, custom...
  vertical           String   @default("custom")
  scope              String   @default("") @db.Text
  forbiddenActions   String   @default("[]") @db.Text // JSON array
  systemPrompt       String   @db.Text // prompt final con placeholders reemplazados
  tools              String   @default("[]") @db.Text // JSON array
  keywords           String   @default("[]") @db.Text // JSON array — routing por palabra clave
  stageMatch         String   @default("[]") @db.Text // JSON array — etapas del pipeline que atiende
  model              String   @default("glm-4.5-flash")
  temperature        Float    @default(0.3)
  tokenLimit         Int      @default(4096)
  priority           Int      @default(100) // mayor = se prefiere ante empate
  status             String   @default("activo") // activo, pausado, configurando, error
  totalMessagesSent  Int      @default(0)
  citasGeneradas     Int      @default(0) // F2 atribución: citas creadas mientras este agente llevaba la conversación
  ventasAtribuidas   Int      @default(0) // F2 atribución: tratos ganados con este agente como último responsable
  templateId         String?
  template           AgentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  workspaceId        String
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([workspaceId])
  @@index([role])
  @@index([status])
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        String   @default("member") // owner, admin, member, viewer
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// ─────────────────────────────────────────────────────────────
// CRM: CONTACTS
// ─────────────────────────────────────────────────────────────

model Contact {
  id          String   @id @default(cuid())
  workspaceId String
  firstName   String
  lastName    String?
  phone       String?
  email       String?
  avatar      String?  @db.Text
  source      String   @default("whatsapp") // whatsapp, instagram, manual, webform
  tags        String   @default("[]") @db.Text // JSON array
  customFields String  @default("{}") @db.Text // JSON object
  status      String   @default("active") // active, inactive, archived, blocked
  leadScore   Int      @default(0)
  temperature String   @default("cold")
  notes       String?  @db.Text
  lastMessageAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  deals        Deal[]
  agentMemories AgentMemory[]
  leadProfile  LeadProfile?
  appointments Appointment[]
  expedienteFiles ExpedienteFile[]
  timelineEvents ContactTimelineEvent[]

  @@unique([workspaceId, phone], name: "contact_workspace_phone_key")
  @@index([workspaceId])
  @@index([phone])
  @@index([status])
  @@index([lastMessageAt])
}

// ─────────────────────────────────────────────────────────────
// CONVERSATIONS & MESSAGES (Multi-Channel)
// ─────────────────────────────────────────────────────────────

model Conversation {
  id          String   @id @default(cuid())
  workspaceId String
  contactId   String?
  channel     String   @default("whatsapp") // whatsapp, instagram, webchat
  externalId  String?  // ID from external provider (e.g. WhatsApp Business API)
  status      String   @default("active") // active, closed, pending, bot
  assignedTo  String?  // userId
  assignedAgentId String? // agent id
  lastMessageAt DateTime @default(now())
  lastMessagePreview String?  @db.Text
  unreadCount Int      @default(0)
  metadata    String   @default("{}") @db.Text // JSON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact    Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  messages   Message[]
  agentLogs  AgentLog[]
  mediaFiles MediaFile[]

  @@index([workspaceId])
  @@index([contactId])
  @@index([channel])
  @@index([status])
  @@index([lastMessageAt])
}

model Message {
  id              String   @id @default(cuid())
  conversationId  String
  content         String   @db.Text
  type            String   @default("text") // text, image, audio, video, document, location, interactive
  direction       String   @default("inbound") // inbound, outbound
  senderType      String   @default("contact") // contact, agent, human, system
  senderId        String?
  externalId      String?
  status          String   @default("sent") // sent, delivered, read, failed
  metadata        String   @default("{}") @db.Text // JSON (media URL, buttons, etc)
  isAiGenerated   Boolean  @default(false)
  agentId         String?
  createdAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  mediaFiles   MediaFile[]

  @@index([conversationId])
  @@index([createdAt])
  @@index([direction])
}

// ─────────────────────────────────────────────────────────────
// AI AGENT SYSTEM (PicoClaw-Style)
// ─────────────────────────────────────────────────────────────

model Agent {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  type        String   @default("qualifier") // qualifier, sales, followup, coach, custom
  description String?
  isActive    Boolean  @default(true)
  model       String   @default("glm") // groq, glm, deepseek, gemini, openai
  modelName   String   @default("glm-4.5-flash")
  temperature Float    @default(0.7)
  maxTokens   Int      @default(4096)
  systemPrompt String  @default("") @db.Text
  personality  String  @default("JHON") // JHON, professional, friendly, aggressive
  priority    Int      @default(0)
  config      String   @default("{}") @db.Text // JSON: hooks, steering, fallback behavior
  webhookUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  logs       AgentLog[]
  memories   AgentMemory[]
  followUpRules FollowUpRule[]

  @@index([workspaceId])
  @@index([type])
  @@index([isActive])
}

model AgentPersona {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  description String?
  systemPrompt String   @db.Text
  tone        String   @default("professional") // professional, casual, aggressive, empathetic
  language    String   @default("es")
  hooks       String   @default("[]") @db.Text // JSON: pre-processing hooks
  steering    String   @default("{}") @db.Text // JSON: conversation steering rules
  revenueRules String @default("[]") @db.Text // JSON: revenue engine rules
  closingRules String @default("[]") @db.Text // JSON: closing engine rules
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}

model AgentLog {
  id              String   @id @default(cuid())
  agentId         String
  conversationId  String
  inputMessage    String   @db.Text
  outputMessage   String?  @db.Text
  model           String?
  tokensUsed      Int      @default(0)
  latencyMs       Int      @default(0)
  confidence      Float    @default(0)
  intent          String?  // detected intent
  action          String?  // action taken
  error           String?  @db.Text
  metadata        String   @default("{}") @db.Text // JSON
  createdAt       DateTime @default(now())

  agent       Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([conversationId])
  @@index([createdAt])
}

model AgentMemory {
  id          String   @id @default(cuid())
  agentId     String
  contactId   String
  key         String
  value       String   @db.Text
  source      String   @default("conversation") // conversation, manual, system
  confidence  Float    @default(1.0)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agent   Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([agentId, contactId, key])
  @@index([agentId])
  @@index([contactId])
}

// ─────────────────────────────────────────────────────────────
// CRM: PIPELINE & DEALS
// ─────────────────────────────────────────────────────────────

model Pipeline {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    PipelineStage[]
  deals     Deal[]

  @@index([workspaceId])
}

model PipelineStage {
  id          String   @id @default(cuid())
  pipelineId  String
  name        String
  color       String   @default("#6366f1")
  order       Int      @default(0)
  probability Int      @default(0) // 0-100 win probability
  isWon       Boolean  @default(false)
  isLost      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@unique([pipelineId, order])
  @@index([pipelineId])
}

model Deal {
  id          String   @id @default(cuid())
  workspaceId String
  pipelineId  String
  stageId     String
  contactId   String?
  assignedTo  String?  // userId
  title       String
  value       Float    @default(0)
  currency    String   @default("MXN")
  description String?  @db.Text
  source      String   @default("whatsapp") // whatsapp, instagram, manual
  status      String   @default("active") // active, won, lost, paused
  wonAt       DateTime?
  lostAt      DateTime?
  lostReason  String?  @db.Text
  closedBy    String?  // userId or agentId
  metadata    String   @default("{}") @db.Text // JSON
  order       Int      @default(0)
  expectedCloseDate DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline     Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage        PipelineStage @relation(fields: [stageId], references: [id])
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  stageHistory DealStageHistory[]

  @@index([workspaceId])
  @@index([pipelineId])
  @@index([stageId])
  @@index([contactId])
  @@index([status])
  @@index([expectedCloseDate])
}

// ─────────────────────────────────────────────────────────────
// FOLLOW-UP AUTOMATION
// ─────────────────────────────────────────────────────────────

model FollowUpRule {
  id          String   @id @default(cuid())
  workspaceId String
  agentId     String?
  name        String
  description String?
  triggerType String   @default("inactivity") // inactivity, scheduled, event-based, deal-stage-change
  triggerConfig String @default("{}") @db.Text // JSON
  channel     String   @default("whatsapp")
  messageTemplate String @default("") @db.Text
  isActive    Boolean  @default(true)
  maxRetries  Int      @default(3)
  cooldownHours Int    @default(24)
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([isActive])
}

model FollowUpTask {
  id          String   @id @default(cuid())
  workspaceId String
  ruleId      String
  contactId   String
  conversationId String
  status      String   @default("pending") // pending, sent, failed, cancelled
  scheduledAt DateTime
  sentAt      DateTime?
  retryCount  Int      @default(0)
  error       String?
  metadata    String?  @db.Text // JSON: {tipo, step} for AI-generated follow-ups
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([status])
  @@index([scheduledAt])
}

// ─────────────────────────────────────────────────────────────
// AUTOMATIONS
// ─────────────────────────────────────────────────────────────

model Automation {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  triggerType String   // webhook, schedule, event, message_received, deal_stage_change
  triggerConfig String @default("{}") @db.Text // JSON
  actions     String   @default("[]") @db.Text // JSON array of actions
  isActive    Boolean  @default(true)
  runCount    Int      @default(0)
  lastRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  logs     AutomationLog[]

  @@index([workspaceId])
  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────
// AUTOMATION LOGS
// ─────────────────────────────────────────────────────────────

model AutomationLog {
  id             String      @id @default(cuid())
  automationId   String
  workspaceId    String
  status         String      @default("success") // success, failed, skipped, partial
  action         String?
  message        String?  @db.Text
  errorMessage   String?  @db.Text // detailed error info
  contactId      String?
  contactName    String?
  metadata       String      @default("{}") @db.Text // JSON
  createdAt      DateTime    @default(now())

  automation     Automation  @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@index([workspaceId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// DEAL STAGE HISTORY
// ─────────────────────────────────────────────────────────────

model DealStageHistory {
  id           String   @id @default(cuid())
  dealId       String
  workspaceId  String
  contactId    String?
  userId       String?  // who triggered the change (null = automation/AI)
  oldStageId   String?
  oldStageName String?
  newStageId   String
  newStageName String
  changedAt    DateTime @default(now())

  deal         Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([workspaceId])
  @@index([changedAt])
}

// ─────────────────────────────────────────────────────────────
// DAILY ANALYTICS SNAPSHOT
// ─────────────────────────────────────────────────────────────

model DailyAnalytics {
  id                  String   @id @default(cuid())
  workspaceId         String
  date                DateTime // midnight of the day (UTC)
  totalMessages       Int      @default(0)
  aiMessages          Int      @default(0)
  newContacts         Int      @default(0)
  activeConversations Int      @default(0)
  dealsCreated        Int      @default(0)
  dealsWon            Int      @default(0)
  pipelineValue       Float    @default(0)
  hotLeads            Int      @default(0)
  avgResponseMs       Int      @default(0) // avg AI latency ms
  metadata            String   @default("{}") @db.Text // JSON for extra stats
  createdAt           DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, date])
  @@index([workspaceId])
  @@index([date])
}

// ─────────────────────────────────────────────────────────────
// MESSAGE DEDUP (persistent cross-restart deduplication)
// ─────────────────────────────────────────────────────────────

model MessageDedup {
  id         String   @id @default(cuid())
  messageId  String   @unique
  processedAt DateTime @default(now())
  expiresAt  DateTime

  @@index([expiresAt])
  @@index([messageId])
}

// ─────────────────────────────────────────────────────────────
// BACKGROUND JOB QUEUE (BullMQ-equivalent without Redis)
// ─────────────────────────────────────────────────────────────

model JobQueue {
  id          String   @id @default(cuid())
  type        String                          // e.g. "send_message", "score_decay", "automation"
  payload     String   @db.Text              // JSON
  status      String   @default("pending")   // pending, processing, done, failed
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  nextRunAt   DateTime @default(now())
  lastError   String?  @db.Text
  workspaceId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, nextRunAt])
  @@index([workspaceId])
  @@index([type, status])
}

// ─────────────────────────────────────────────────────────────
// BILLING & SUBSCRIPTIONS
// ─────────────────────────────────────────────────────────────

model Subscription {
  id                String   @id @default(cuid())
  workspaceId       String   @unique
  plan              String   @default("free") // free, starter, pro, enterprise
  status            String   @default("active") // active, past_due, cancelled, trialing
  provider          String   @default("stripe") // stripe, mercado_pago
  providerPlanId    String?
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEnd          DateTime?
  cancelAt          DateTime?
  cancelledAt       DateTime?
  amount            Float    @default(0)
  currency          String   @default("MXN")
  interval          String   @default("monthly") // monthly, yearly
  metadata          String   @default("{}") @db.Text // JSON
  stripeCustomerId      String? // Stripe customer ID
  stripeSubscriptionId  String? // Stripe subscription ID
  couponCode        String?
  discountAmount    Float?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([status])
  @@index([couponCode])
}

model Coupon {
  id                         String   @id @default(cuid())
  code                       String   @unique
  name                       String
  description                String?  @db.Text
  discountType               String   // percent, fixed
  discountValue              Float
  currency                   String   @default("MXN")
  duration                   String   @default("once") // once, forever, repeating
  durationInMonths           Int?
  appliesToPlans             String   @default("[]") @db.Text // JSON array: starter, pro, enterprise
  maxRedemptions             Int?
  maxRedemptionsPerWorkspace Int      @default(1)
  redeemedCount              Int      @default(0)
  startsAt                   DateTime?
  expiresAt                  DateTime?
  isActive                   Boolean  @default(true)
  stripeCouponId             String?
  metadata                   String   @default("{}") @db.Text
  createdById                String?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  createdBy   User?              @relation("CouponCreator", fields: [createdById], references: [id], onDelete: SetNull)
  redemptions CouponRedemption[]

  @@index([code])
  @@index([isActive])
  @@index([expiresAt])
  @@index([createdById])
}

model CouponRedemption {
  id                String   @id @default(cuid())
  couponId          String
  workspaceId       String
  subscriptionId    String?
  checkoutSessionId String?  @unique
  plan              String
  discountAmount    Float?
  currency          String   @default("MXN")
  status            String   @default("redeemed") // redeemed, void
  metadata          String   @default("{}") @db.Text
  redeemedAt        DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([workspaceId])
  @@index([subscriptionId])
  @@index([status])
  @@index([redeemedAt])
}

// ─────────────────────────────────────────────────────────────
// ANALYTICS & EVENTS
// ─────────────────────────────────────────────────────────────

model AnalyticsEvent {
  id          String   @id @default(cuid())
  workspaceId String
  eventType   String   // conversation_created, message_sent, deal_won, agent_used, etc
  eventData   String   @default("{}") @db.Text // JSON
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([eventType])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// WEBHOOK CONFIGS
