model AnalyticsAlert {
  id          String    @id @default(cuid())
  workspaceId String
  contactId   String?
  alertType   String // ghosting_risk, ghosted, engagement_drop, sentiment_shift, funnel_stuck, response_time_spike
  severity    String    @default("warning") // info, warning, critical
  title       String
  description String
  metadata    String    @default("{}") // JSON: { expectedIntervalMs, actualIntervalMs, dealStage, ... }
  isRead      Boolean   @default(false)
  isResolved  Boolean   @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([contactId])
  @@index([alertType])
  @@index([severity])
  @@index([isResolved])
  @@index([createdAt])
}

model FunnelSnapshot {
  id           String   @id @default(cuid())
  workspaceId  String
  snapshotDate DateTime @default(now())
  period       String   @default("daily") // daily, weekly, monthly

  // Funnel counts per stage
  contactCount     Int @default(0) // total contacts
  qualifiedCount   Int @default(0) // contacts qualified
  proposalCount    Int @default(0) // contacts with proposals
  negotiationCount Int @default(0) // contacts in negotiation
  wonCount         Int @default(0) // deals won
  lostCount        Int @default(0) // deals lost

  // Metrics
  avgDaysInStage  String  @default("{}") // JSON: { "qualified": 5.2, "proposal": 3.1, ... }
  dropOffRates    String  @default("{}") // JSON: { "contact_to_qualified": 0.35, ... }
  bottleneckStage String? // which stage has longest avg time

  // Value metrics
  totalPipelineValue Float @default(0) // sum of active deal values
  wonValue           Float @default(0) // sum of won deal values in period
  lostValue          Float @default(0) // sum of lost deal values in period

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([snapshotDate])
  @@index([period])
}

