// ─────────────────────────────────────────────────────────────
// EXPEDIENTE DIGITAL (Revenue Engine — submódulo 8)
// Documentos vinculados a un contacto: INE, RFC, comprobante,
// contrato, cotización, factura. Habilita facturación y cierre.
// ─────────────────────────────────────────────────────────────

model ExpedienteFile {
  id          String   @id @default(cuid())
  workspaceId String
  contactId   String
  // ine | comprobante_domicilio | rfc | identificacion | contrato | cotizacion | factura | otro
  category    String   @default("otro")
  fileName    String
  mimeType    String   @default("application/octet-stream")
  fileSize    Int      @default(0) // bytes
  filePath    String   @db.Text // relative path on disk or external URL
  source      String   @default("upload") // upload | whatsapp | system
  mediaFileId String?  // originating MediaFile id, if attached from a message
  notes       String?  @db.Text
  uploadedBy  String?  // userId if uploaded by an agent
  metadata    String   @default("{}") @db.Text // JSON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([contactId])
  @@index([category])
}

// ─────────────────────────────────────────────────────────────
// EXPEDIENTE: BITÁCORA / TIMELINE (per-contact running log)
// La IA y el sistema van anotando, en orden cronológico, los puntos
// importantes de cada conversación: intereses, intenciones, presupuesto,
// objeciones, citas, documentos, consentimientos y resúmenes IA.
// Da historial completo y trazabilidad por contacto (ValiGuard + inbox).
// ─────────────────────────────────────────────────────────────

model ContactTimelineEvent {
  id             String   @id @default(cuid())
  workspaceId    String
  contactId      String
  conversationId String?
  // interest | budget | intention | objection | archetype | painpoint |
  // appointment | document | consent | deal | milestone | ai_summary | note
  type           String
  title          String   @db.Text          // línea corta legible (lo que se anota)
  detail         String?  @db.Text          // nota más larga (opcional)
  dedupeKey      String?                     // valor normalizado para deduplicar cambios
  source         String   @default("system") // ai | system | human
  importance     String   @default("normal") // low | normal | high
  metadata       String   @default("{}") @db.Text // JSON
  createdAt      DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([contactId, createdAt])
  @@index([type])
}

// ─────────────────────────────────────────────────────────────
// AI TRAINING / COACHING (in-context learning)
// Correcciones y ejemplos reales que el operador enseña a la IA.
// Se inyectan en el prompt en CADA respuesta (no es fine-tuning):
// la IA lee estas "lecciones" y deja de repetir errores + imita al
// vendedor humano. Alimentado desde el inbox, el estudio de
// entrenamiento, y la importación de transcripciones .txt.
// ─────────────────────────────────────────────────────────────

model AiTrainingExample {
  id          String   @id @default(cuid())
  workspaceId String
  // correction = la IA respondió mal y se corrige | example = buena respuesta a imitar
  type        String   @default("correction")
  trigger     String   @db.Text            // mensaje/contexto del cliente que dispara la lección
  badResponse String?  @db.Text            // lo que la IA respondió mal (opcional)
  goodResponse String  @db.Text            // lo que DEBE responder
  note        String?  @db.Text            // motivo / la lección
  source      String   @default("playground") // inbox | playground | upload
  sourceConversationId String?
  sourceMessageId      String?
  isActive    Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isActive])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// MERCADO LIBRE — conexión (OAuth), publicaciones y bitácora.
// Permite conectar la cuenta ML del cliente, publicar autos del
// inventario y gestionar todo (publicaciones, preguntas, ventas)
// desde aquí, con trazabilidad completa.
// ─────────────────────────────────────────────────────────────

model MeliConnection {
